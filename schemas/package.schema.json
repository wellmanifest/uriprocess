{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wellmanifest.dev/uriprocess/package.schema.v1.json",
  "$defs": {
    "poa-node-v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "process_ref",
        "contract",
        "language",
        "entry",
        "export",
        "transport",
        "request_fields",
        "base_image",
        "role",
        "executes_declared_capabilities",
        "authority",
        "source"
      ],
      "properties": {
        "schema": {
          "const": "uriprocess.package/v1"
        },
        "process_ref": {
          "type": "string",
          "minLength": 4,
          "maxLength": 2048,
          "pattern": "^[a-z][a-z0-9+.-]*://[^\\s]+$"
        },
        "contract": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "language": {
          "const": "javascript"
        },
        "entry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "export": {
          "type": "string",
          "minLength": 1
        },
        "transport": {
          "const": "stdin-json"
        },
        "request_fields": {
          "const": [
            "ticket",
            "context"
          ]
        },
        "base_image": {
          "type": "string",
          "pattern": "^[^\\s@]+@sha256:[0-9a-f]{64}$"
        },
        "role": {
          "const": "decision-library"
        },
        "executes_declared_capabilities": {
          "const": false
        },
        "authority": {
          "const": "decision-only; no execution grant"
        },
        "source": {
          "const": "provenance.json"
        }
      }
    },
    "python-native-v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "public_uris",
        "native_manifest",
        "native_distribution",
        "native_version",
        "entry_points",
        "dependencies",
        "source",
        "production_binding_verified"
      ],
      "properties": {
        "schema": {
          "const": "uriprocess.native-package/v1"
        },
        "kind": {
          "const": "python-connector"
        },
        "public_uris": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 4,
            "maxLength": 2048,
            "pattern": "^[a-z][a-z0-9+.-]*://[^\\s]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "native_manifest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "native_distribution": {
          "type": "string",
          "minLength": 1
        },
        "native_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "entry_points": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source": {
          "const": "provenance.json"
        },
        "production_binding_verified": {
          "const": false
        }
      }
    },
    "rust-uri-v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "public_uris",
        "crate_name",
        "crate_version",
        "cargo_manifest",
        "transports",
        "ffi_symbol",
        "python_bridge",
        "source",
        "production_binding_verified"
      ],
      "properties": {
        "schema": {
          "const": "uriprocess.rust-package/v1"
        },
        "kind": {
          "const": "rust-uri-process"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "profile": {
          "const": "rust-uri-v1"
        },
        "public_uris": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 4,
            "maxLength": 2048,
            "pattern": "^[a-z][a-z0-9+.-]*://[^\\s]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "crate_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "crate_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "cargo_manifest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "transports": {
          "type": "array",
          "items": {
            "enum": [
              "cdylib-c-abi",
              "pyo3-abi3",
              "json-stdin-stdout"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "ffi_symbol": {
          "type": "string",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
        },
        "python_bridge": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "module",
            "fallback_module",
            "priority_chain"
          ],
          "properties": {
            "module": {
              "type": "string",
              "minLength": 1
            },
            "entrypoint": {
              "type": "string",
              "minLength": 1
            },
            "fallback_module": {
              "type": "string",
              "minLength": 1
            },
            "priority_chain": {
              "type": "array",
              "items": {
                "enum": [
                  "floor:rust-cdylib",
                  "standard:rust-stdio",
                  "opportunistic:python-fallback"
                ]
              },
              "minItems": 2,
              "uniqueItems": true
            }
          }
        },
        "processes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "source": {
          "const": "provenance.json"
        },
        "production_binding_verified": {
          "const": false
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "repository",
        "revision",
        "files"
      ],
      "properties": {
        "schema": {
          "const": "uriprocess.provenance/v1"
        },
        "repository": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "destination",
              "sha256"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "destination": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "mode": {
                "enum": [
                  420,
                  493
                ]
              }
            }
          },
          "minItems": 1,
          "maxItems": 4096
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/poa-node-v1"
    },
    {
      "$ref": "#/$defs/python-native-v1"
    },
    {
      "$ref": "#/$defs/rust-uri-v1"
    },
    {
      "$ref": "#/$defs/provenance"
    }
  ]
}
